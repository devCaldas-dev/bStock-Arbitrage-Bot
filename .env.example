# ==============================================================================
# Configuración del Bot de Arbitraje de Acciones Tokenizadas (bStocks)
# ==============================================================================

# Clave de API para acceder a la API de Ondo Finance (https://api.gm.ondo.finance)
# Requerida para consultar precios oficiales primarios y subyacentes
ONDO_API_KEY=your_ondo_api_key_here

# Credenciales de la API oficial de datos RWA de Binance Web3
BINANCE_WEB3_API_KEY=tu_api_key_aqui
BINANCE_WEB3_API_SECRET=tu_api_secret_aqui

# Wallet (solo flujo LIVE en demo_live.py --live)
WALLET_ADDRESS=0xYourWalletAddressHere
WALLET_PRIVATE_KEY=0xYourPrivateKeyHereNeverCommitRealKeys

# Límite de seguridad para --live (entero positivo, obligatorio con --live)
MAX_LIVE_TX_PER_SESSION=2
